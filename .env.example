# Upstash Redis connection details
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password required to access the generator and dashboard
DASHBOARD_PASSWORD=change-me

# A long random value used to sign the login cookie
SESSION_SECRET=change-me-too-make-it-long-and-random

# Your deployed domain, without a trailing slash
# Local development value:
NEXT_PUBLIC_SITE_URL=http://localhost:3000